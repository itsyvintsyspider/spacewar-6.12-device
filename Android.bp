soong_namespace {
}

install_symlink {
    name: "firmware_wlanmdsp.otaupdate_symlink",
    vendor: true,
    installed_location: "firmware/wlanmdsp.otaupdate",
    symlink_target: "/data/vendor/firmware/wlanmdsp.mbn",
}

install_symlink {
    name: "firmware_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/qca6750/wlan_mac.bin",
}

prebuilt_hidl_interfaces {
    name: "hidl_noth_sensor_extension_interface",
    interfaces: [
        "vendor.noth.hardware.sensor.sensor_extension@1.0::ISensorExtension",
    ],
}

// Headers NXP NFC HAL expects from securemsm; not in tree.
cc_library_headers {
    name: "mink_headers",
    vendor: true,
    host_supported: false,
}

cc_library_headers {
    name: "peripheralstate_headers",
    vendor: true,
    host_supported: false,
}
